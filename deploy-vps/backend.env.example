# Jangan commit backend.env! APP_KEY akan dibuat otomatis oleh prepare-env.sh.
APP_NAME=HiruAcademy
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
TRUSTED_PROXIES=*
SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MEDIA_DISK=public
FILESYSTEM_DISK=local
# Ubah ke SMTP production untuk mengaktifkan email reset password.
MAIL_MAILER=log
